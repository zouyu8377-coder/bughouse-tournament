{
  "name": "bughouse-tournament",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron ."
  },
  "dependencies": {
    "dexie": "^3.2.4",
    "pinia": "^2.1.0",
    "sortablejs": "^1.15.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vue-tsc": "^1.8.0"
  },
  "build": {
    "appId": "com.bughouse.tournament",
    "productName": "Bughouse比赛编排系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis"
    }
  }
}
